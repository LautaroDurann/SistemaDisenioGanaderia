# Copiá este archivo como .env y completá los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# URL pública del sitio, usada en los enlaces que llegan por correo.
# En producción poné el dominio real (ej: https://ganastock.com).
# Si queda vacío se usa el host de la petición (127.0.0.1:8000 en local).
SITE_URL=

# -------- Opción A: Gmail --------
# Necesitás una "Contraseña de aplicación" (no la contraseña normal):
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=tucorreo@gmail.com
EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=tucorreo@gmail.com

# -------- Opción B: Outlook / Hotmail --------
#EMAIL_HOST=smtp.office365.com
#EMAIL_PORT=587
#EMAIL_USE_TLS=True
#EMAIL_USE_SSL=False
#EMAIL_HOST_USER=tucorreo@outlook.com
#EMAIL_HOST_PASSWORD=tucontraseña
#DEFAULT_FROM_EMAIL=tucorreo@outlook.com
